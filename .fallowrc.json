{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "index.js",
    "server/index.js",
    "server/gamenode/index.ts",
    "server/api/**/*.{ts,js}",
    "test/**/*.spec.{ts,js}",
    "tools/**/*.js"
  ],
  "ignorePatterns": [
    "build/**",
    "graphify-out/**",
    "test/json/**",
    "test/fixtures/**",
    "tools/selfplay/out/**",
    "tools/selfplay/fixtures/**"
  ],
  "dynamicallyLoaded": [
    "server/game/cards/**/*.ts"
  ],
  "boundaries": {
    "zones": [
      { "name": "bot-router", "patterns": ["server/game/bots/BotEngineRouter.ts"] },
      { "name": "bot-shared", "patterns": ["server/game/bots/shared/**"] },
      { "name": "bot-v2", "patterns": ["server/game/bots/v2/**"] },
      { "name": "bot-v1", "patterns": ["server/game/bots/*.{ts,js}"] },
      { "name": "game", "patterns": ["server/game/**"] }
    ],
    "rules": [
      { "from": "bot-router", "allow": ["bot-v1", "bot-v2", "bot-shared", "game"] },
      { "from": "bot-v1", "allow": ["bot-router", "bot-shared", "game"] },
      { "from": "bot-shared", "allow": ["bot-v1", "game"] },
      { "from": "bot-v2", "allow": ["bot-shared", "bot-v1", "game"] },
      { "from": "game", "allow": [] }
    ]
  }
}
